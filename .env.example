# Copy to .env and fill in real values from Supabase Dashboard → Settings → API

# TODO: Replace YOUR_PROJECT_ID and keys below
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Public URL for QR codes / review links (phone must reach this host).
# Use your production domain, or while testing: http://YOUR_LAN_IP:5173 with npm run dev -- --host
# Also used as the “View Dashboard” link base in low-rating alert emails when set.
# VITE_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Low-rating owner emails (Resend) ---
# Do NOT add VITE_RESEND_API_KEY: anything prefixed with VITE_ is exposed in the browser bundle.
# If any API key was pasted into chat, email, or a ticket, revoke it in the provider dashboard and create a new one.
# Deploy supabase/functions/send-low-rating-email and set Supabase secrets:
#   RESEND_API_KEY   (from resend.com)
#   RESEND_FROM      (optional, e.g. ReviewBoost <noreply@yourdomain.com>)
#   PUBLIC_APP_URL   (optional fallback dashboard origin if the client sends none)
# Apply migration supabase/migrations/20260504120000_profiles.sql for public.profiles + auth sync.
