# Copy to .env and fill in real values from Supabase Dashboard → Settings → API

# TODO: Replace YOUR_PROJECT_ID and keys below
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Public URL for QR codes / review links (phone must reach this host).
# Use your production domain, or while testing: http://YOUR_LAN_IP:5173 with npm run dev -- --host
# Also used as the “View Dashboard” link base in low-rating alert emails when set.
# VITE_PUBLIC_APP_URL=https://your-app.vercel.app

# Razorpay Checkout (browser — Key Id only; never put Key Secret in Vite)
# Must match the mode (test/live) of your Edge Function secrets below.
# VITE_RAZORPAY_KEY_ID=rzp_test_...
#
# Edge Function `create-razorpay-order` (required so the browser never hits api.razorpay.com with Basic Auth):
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_... RAZORPAY_KEY_SECRET=...
#   supabase functions deploy create-razorpay-order
# Use the same Key Id as VITE_RAZORPAY_KEY_ID plus the matching Key Secret from Razorpay Dashboard.

# --- Low-rating owner emails (Resend + Edge Function) ---
# Never use VITE_* for Resend — keys would be public in the bundle.
# If a key was leaked, revoke it in Resend and create a new one.
#
# Setup:
# 1) Deploy: supabase functions deploy send-low-rating-email
#    (uses supabase/config.toml → verify_jwt = false so guests can invoke after submit)
#    If you deploy only from Dashboard, turn OFF “Enforce JWT” for this function.
# 2) Secrets — Supabase Dashboard → Project Settings → Edge Functions → Secrets
#    Name: RESEND_API_KEY   Value: re_... from resend.com
#    Optional: RESEND_FROM (e.g. ReviewBoost <onboarding@resend.dev>)
#    Optional: PUBLIC_APP_URL (dashboard link base)
#    Or CLI: supabase secrets set RESEND_API_KEY=re_...
# 3) Apply migration supabase/migrations/20260504120000_profiles.sql (profiles + auth sync).
#
# onboarding@resend.dev may only deliver to addresses allowed in Resend until you verify a domain.
